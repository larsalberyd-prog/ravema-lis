# Mall för .env på VPS — riktig fil ligger ALDRIG i git.
# Generera värden vid setup, lagra i ~/.secrets/ovh-ravema.env eller liknande.

# MySQL (i Docker-container)
MYSQL_ROOT_PASSWORD=<openssl rand -hex 24>
MYSQL_PASSWORD=<openssl rand -hex 24>

# Node-app
JWT_SECRET=<openssl rand -hex 32>
DEMO_LOGIN_KEY=<openssl rand -hex 24>

# Caddy basic auth — bcrypt-hashar (generera med: caddy hash-password)
# Lösenord kommuniceras separat till Klas/Nejra via Signal/password manager.
BASICAUTH_KLAS_HASH=$2a$14$REPLACEMEWITHBCRYPTHASHFORKLAS
BASICAUTH_NEJRA_HASH=$2a$14$REPLACEMEWITHBCRYPTHASHFORNEJRA
